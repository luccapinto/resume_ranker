# ── LLM (OpenRouter) ────────────────────────────────────────────────
# Obtenha uma chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ── Embeddings ──────────────────────────────────────────────────────
# local  → SentenceTransformers na própria máquina (padrão, sem custo)
# openai → requer OPENAI_API_KEY
# voyage → requer VOYAGE_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=resume_ranker

# ── Qdrant ──────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── App ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
