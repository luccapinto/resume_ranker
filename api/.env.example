# ── LLM (OpenRouter) ────────────────────────────────────────────────
# Obtenha uma chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# The same model is served by many providers with wildly different throughput.
# "throughput" prefers the fast ones; leave empty to let OpenRouter decide.
OPENROUTER_PROVIDER_SORT=throughput
# Comma-separated provider names to avoid entirely, e.g. DigitalOcean
OPENROUTER_IGNORE_PROVIDERS=

# Per-task models. Benchmarked with api/eval/benchmark_models.py and
# benchmark_citations.py: extraction is mechanical and schema-bound, where a
# small non-reasoning model is faster, cheaper and more accurate; explanation
# needs faithful verbatim quoting, where the reasoning model still wins.
# Leave empty to fall back to OPENROUTER_MODEL.
OPENROUTER_MODEL_EXTRACTION=openai/gpt-4.1-nano
OPENROUTER_MODEL_EXPLANATION=
OPENROUTER_MODEL_COPILOT=

# ── Embeddings ──────────────────────────────────────────────────────
# local  → SentenceTransformers na própria máquina (padrão, sem custo)
# openai → requer OPENAI_API_KEY
# voyage → requer VOYAGE_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina-uma-senha-forte-aqui
POSTGRES_DB=resume_ranker

# ── Qdrant ──────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── App ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
